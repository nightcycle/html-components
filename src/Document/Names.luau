-- References
-- Global Variables
local tags: { [string]: string } = {}
local attributes: { [string]: string } = {}
for _, name in SVG_TAGS do
	tags[string.lower(name)] = name
end
for _, name in SVG_ATTRIBUTES do
	attributes[string.lower(name)] = name
end
-- Private Functions
local function pascal(value: string): string
	return (value:gsub("^[a-z]", string.upper):gsub("[-_:]([a-z])", string.upper))
end
-- Class
return {
	Pascal = pascal,
	SVGTag = function(name: string): string
		return tags[name] or name
	end,
	SVGAttribute = function(name: string): string
		return attributes[name] or name
	end,
}
